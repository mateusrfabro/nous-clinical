# Nous Clinical — variaveis de ambiente. Copie para .env e preencha.

# === OBRIGATORIO ===
# Gere: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROCAR_AQUI_COM_CHAVE_ALEATORIA
# Senha do Postgres (usada no docker-compose)
DB_PASSWORD=TROCAR_AQUI_SENHA_FORTE

# === OPCIONAL (defaults razoaveis) ===
FLASK_ENV=production
# DATABASE_URL=postgresql://nous:SENHA@db:5432/nous  (compose ja seta)
RUN_SEED=false
# PORT=5050
# WEB_WORKERS=4
# CACHE_REDIS_URL=redis://redis:6379/1
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# === SMTP (opcional — habilita reset de senha por e-mail) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contato@suaclinica.com
# SMTP_PASSWORD=app-password-de-16-chars
# SMTP_FROM=Nous Clinical <contato@suaclinica.com>
# SMTP_USE_SSL=false

# === Storage de arquivos (logo + exames) ===
# Disco local some em PaaS efemero (Render). Em producao use S3/Cloudflare R2:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com   # R2
# S3_BUCKET=nous-clinical
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto

# === Telegram (opcional — lembrete/reset via bot) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=nousclinicalbot
